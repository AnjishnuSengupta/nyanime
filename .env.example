# ============================================================================
# NyAnime — Environment Configuration Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================================

# ============================================================================
# 🔥 FIREBASE CONFIGURATION (REQUIRED)
# ============================================================================
# Get from: https://console.firebase.google.com/
# Navigate to: Project Settings → General → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENTID=

# ============================================================================
# 🎬 ANIMEKAI BACKEND API (Server-side — Render / self-hosted)
# ============================================================================
# Used by server.js to call the hosted AnimeKAI backend for stream resolution.
# On Render: leave empty — server.js auto-constructs the URL from RENDER_EXTERNAL_URL.
# Self-hosted: set to your deployed animekai_api_service URL.
ANIMEKAI_API_URL=

# ============================================================================
# 📝 SUBTITLE PROVIDER — jimaku.cc (RECOMMENDED)
# ============================================================================
# Free API token — get from https://jimaku.cc → Account Settings → API
# Without this, subtitles will silently not load (no errors, just no CC button).
JIMAKU_API_TOKEN=

# ============================================================================
# 🔑 OPTIONAL API KEYS
# ============================================================================

# YouTube Data API v3 — for fetching anime trailers
# Get from: https://console.cloud.google.com/apis/credentials → Enable "YouTube Data API v3"
VITE_YOUTUBE_API_KEY=

# TMDB (The Movie Database) — additional metadata/posters (not currently active)
# Get from: https://www.themoviedb.org/settings/api
VITE_TMDB_READ_ACCESS_TOKEN=

# ============================================================================
# ⚙️ APP CONFIGURATION
# ============================================================================
VITE_APP_NAME=NyAnime
VITE_APP_VERSION=2.6.0

# ============================================================================
# 📋 VARIABLE SUMMARY
# ============================================================================
#
# REQUIRED — app won't start without these:
#   ✅ VITE_FIREBASE_API_KEY
#   ✅ VITE_FIREBASE_AUTH_DOMAIN
#   ✅ VITE_FIREBASE_PROJECT_ID
#   ✅ VITE_FIREBASE_STORAGE_BUCKET
#   ✅ VITE_FIREBASE_MESSAGING_SENDER_ID
#   ✅ VITE_FIREBASE_APP_ID
#
# RECOMMENDED — subtitles and streaming work better with these:
#   ⭐ JIMAKU_API_TOKEN          (free, needed for subtitle CC tracks)
#   ⭐ ANIMEKAI_API_URL          (needed if self-hosting AnimeKAI backend)
#
# OPTIONAL — app works without these:
#   ⚪ VITE_YOUTUBE_API_KEY      (trailers fall back to Jikan embed links)
#   ⚪ VITE_TMDB_READ_ACCESS_TOKEN (unused in current release)
#   ⚪ VITE_FIREBASE_MEASUREMENTID (Analytics only)
